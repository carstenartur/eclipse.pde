+package org.eclipse.pde.core.tests.internal;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.Callable;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+
+import org.eclipse.pde.internal.core.schema.Schema;
+import org.junit.jupiter.api.Test;
+
+public class SchemaXmlReaderTest {
+
+	private static String document(String name) {
+		return "<schema><annotation><appinfo><meta.schema plugin='test' id='point' name='" + name
+				+ "'/></appinfo><documentation> leading<![CDATA[ <raw>]]>&amp;middle<!--comment-->tail </documentation>"
+				+ "</annotation><element name='extension'><complexType><attribute name='id' type='string' use='required'/>"
+				+ "</complexType></element></schema>";
+	}
+
+	private static Schema load(String xml) {
+		Schema schema = new Schema("test", "point", "Test", false);
+		schema.load(new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8)));
+		return schema;
+	}
+
+	@Test
+	public void loadsModelWithMixedDocumentation() {
+		Schema schema = load(document("Test"));
+		assertTrue(schema.isLoaded());
+		assertTrue(schema.isValid());
+		assertEquals("leading <raw>&middletail", schema.getDescription());
+		assertEquals(1, schema.getElementCount());
+		assertEquals("id", schema.findElement("extension").getAttributes()[0].getName());
+	}
+
+	@Test
+	public void rejectsDoctypeAndMalformedXml() {
+		for (String declaration : List.of("<!DOCTYPE schema>",
+				"<!DOCTYPE schema [<!ENTITY e 'value'>]>",
+				"<!DOCTYPE schema SYSTEM 'file:///intentionally-missing.dtd'>",
+				"<!DOCTYPE schema SYSTEM 'http://127.0.0.1:9/intentionally-missing.dtd'>",
+				"<!DOCTYPE schema [<!ENTITY % e SYSTEM 'file:///intentionally-missing.dtd'>%e;]>")) {
+			assertFalse(load(declaration + document("Test")).isLoaded(), declaration);
+			assertTrue(load(document("After rejection")).isLoaded());
+		}
+		assertFalse(load("<schema><element></schema>").isLoaded());
+	}
+
+	@Test
+	public void concurrentLoadsKeepSeparateModels() throws Exception {
+		var executor = Executors.newFixedThreadPool(4);
+		try {
+			List<Callable<String>> calls = new ArrayList<>();
+			for (int i = 0; i < 32; i++) {
+				String name = "Schema " + i;
+				calls.add(() -> load(document(name)).getName());
+			}
+			var results = executor.invokeAll(calls, 10, TimeUnit.SECONDS);
+			for (int i = 0; i < results.size(); i++) {
+				assertEquals("Schema " + i, results.get(i).get());
+			}
+		} finally {
+			executor.shutdownNow();
+		}
+	}
+}
