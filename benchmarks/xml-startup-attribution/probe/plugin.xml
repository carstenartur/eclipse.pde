<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension id="prepareWorkspace" point="org.eclipse.core.runtime.applications">
      <application cardinality="singleton-global" thread="main" visible="false">
         <run class="org.eclipse.pde.xmlstudy.probe.PrepApplication"/>
      </application>
   </extension>
   <extension id="headlessDiagnostic" point="org.eclipse.core.runtime.applications">
      <application cardinality="singleton-global" thread="main" visible="false">
         <run class="org.eclipse.pde.xmlstudy.probe.HeadlessDiagnosticApplication"/>
      </application>
   </extension>
</plugin>
